<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }} &mdash; {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or site.footerTagline }}">
<link rel="icon" href="/images/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;1,500&family=Work+Sans:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600;700&family=Imperial+Script&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap site-header__row">
    <a class="brand" href="/"><img src="/images/logo-white-transparent.png" alt="Nest Cafe" class="brand__logo"></a>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <span aria-hidden="true">&#9776;</span>
    </button>
    <nav class="site-nav" id="site-nav">
      <a href="/">Home</a>
      {% for item in site.nav %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
      <a class="site-nav__icon" href="{{ site.instagramLink }}" aria-label="Nest Cafe on Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1"/></svg>
      </a>
      <a class="site-nav__icon" href="mailto:{{ site.email }}" aria-label="Email Nest Cafe">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/></svg>
      </a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap site-footer__row">
    <div class="site-footer__about">
      <p class="site-footer__brand">Nest Cafe</p>
      <p>{{ site.footerTagline }}</p>
    </div>
    <div class="site-footer__col">
      <p class="site-footer__heading">Explore</p>
      <a href="/about/">About</a>
      <a href="/events/">Events</a>
      <a href="/recipes/">Recipes</a>
    </div>
    <div class="site-footer__col">
      <p class="site-footer__heading">Say hello</p>
      <a href="/contact/">Contact</a>
      <a href="{{ site.instagramLink }}">Instagram</a>
    </div>
  </div>
  <div class="wrap site-footer__copy">
    &copy; {{ currentYear }} Nest Cafe &middot; Made with love in {{ site.city }}
  </div>
</footer>

<script src="/js/nav.js"></script>
{% if extraScript %}<script src="/js/{{ extraScript }}"></script>{% endif %}
</body>
</html>
